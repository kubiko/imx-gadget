#!/bin/sh

# try to setup mount for secure-storage
# ignore error, once hooks is connected we will try again
snapctl mount \
        --persistent \
        -t ext4 \
        -o rw \
        "/dev/disk/by-partlabel/secure-storage" \
        "${SNAP_COMMON}/secure-storage" \
        || true

# tee storage lives in the tee dir, so we  share it with ELE where available
mkdir -p "${SNAP_COMMON}/secure-storage/tee"

# Start service to generate device
# Reenable when interfaces are auto connected
# snapctl start "${SNAP_INSTANCE_NAME}.generate-hw-id-key" || true &
