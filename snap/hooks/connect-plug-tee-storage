#!/bin/sh

# setup mount
snapctl mount \
        --persistent \
        -t ext4 \
        -o rw \
        "/dev/disk/by-partlabel/tee-storage" \
        "${SNAP_COMMON}/tee-storage"

# if tee is connected, enable services
if snapctl is-connected tee; then
  snapctl start --enable "${SNAP_INSTANCE_NAME}.tee-supplicant"
  # socket activated: this enables and starts their sockets
  snapctl start --enable \
          "${SNAP_INSTANCE_NAME}.p11-kit-server-0" \
          "${SNAP_INSTANCE_NAME}.p11-kit-server-1" \
          "${SNAP_INSTANCE_NAME}.p11-kit-server-2"
fi

# if the EdgeLock Enclave is connected, enable its services
if snapctl is-connected ele-hsm; then
  snapctl start --enable "${SNAP_INSTANCE_NAME}.ele-nvm-daemon"
  snapctl start --enable "${SNAP_INSTANCE_NAME}.p11-kit-server-ele-0"
fi
