#!/bin/sh

# The ELE NVM manager serves the EdgeLock Enclave's requests to keep and
# fetch the blobs of its key storage, as tee-supplicant does for OP-TEE.
# Keep them on the secure-storage partition, next to OP-TEE's REE FS: with
# the SMW object database, they have to survive, or go, together.

storage="${SNAP_COMMON}/secure-storage"
# mounted: on a file system of its own (mountpoint is not in the sandbox)
if [ ! -d "${storage}" ] ||
   [ "$(stat -c %d "${storage}")" = "$(stat -c %d "${SNAP_COMMON}")" ]; then
  echo "ele-nvm-daemon: ${storage} is not mounted, not keeping ELE storage elsewhere" >&2
  exit 1
fi

# nvm_daemon prefixes the blob names with the directory as given
dir="${storage}/ele/"
mkdir -p "${dir}"

# 0x80: the NVM session of the HSM interface
"${SNAP}/usr/bin/nvm_daemon" "${dir}ele_nvm_master" "${dir}" 0x80

# nvm_daemon serves the enclave until it is stopped, and exits 0 even when
# it cannot open the ELE storage: fail, so that systemd restarts it
echo "ele-nvm-daemon: nvm_daemon exited" >&2
exit 1
